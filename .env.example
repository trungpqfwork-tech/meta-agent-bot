# Create outside repository AND outside agent workspace. chmod 600.
# Parsed locally, never exported to process.env or supplied to the agent.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# At least 32 random characters. Used only by the local operator console.
CSKH_ADMIN_TOKEN=
# Alert bot used by the CSKH service for order/handoff notifications.
TELEGRAM_BOT_TOKEN=

# Optional: separate Telegram bot for the Hermes admin agent. setup-admin-agent.sh
# imports these into the cskh-admin Hermes profile as TELEGRAM_BOT_TOKEN and
# TELEGRAM_ALLOWED_USERS. Use a different bot than the alert bot above.
PAGE_CSKH_ADMIN_TELEGRAM_BOT_TOKEN=
PAGE_CSKH_ADMIN_TELEGRAM_ALLOWED_USERS=

# Runtime identity/config. `npm run generate-config -- --env /runtime/.env`
# writes config.json from these values.
PAGE_CSKH_PAGE_ID=
PAGE_CSKH_APP_ID=
PAGE_CSKH_PAGE_NAME=
PAGE_CSKH_PUBLIC_WEBHOOK_URL=https://REPLACE_DOMAIN/webhooks/page-cskh
PAGE_CSKH_MODEL=REPLACE_PROVIDER/REPLACE_MODEL
PAGE_CSKH_AGENT_ID=page-cskh
PAGE_CSKH_GRAPH_VERSION=v25.0
PAGE_CSKH_WEBHOOK_PATH=/webhooks/page-cskh
PAGE_CSKH_ADMIN_PORT=18891
PAGE_CSKH_EDGE_PORT=18892
PAGE_CSKH_ENV_FILE=./.env
PAGE_CSKH_DATABASE=./data/page.sqlite
PAGE_CSKH_WORKSPACE=./agent
# Optional dedicated Hermes home/profile for CSKH completions. It stores model/runtime persona only;
# customer memory still lives only in SQLite.
PAGE_CSKH_HERMES_HOME=./hermes-cskh
PAGE_CSKH_KNOWLEDGE_FILE=./knowledge.json
PAGE_CSKH_IMAGE_DIR=./images
PAGE_CSKH_IMAGE_CATALOG_FILE=./images/catalog.json

# Runtime controls.
PAGE_CSKH_MODE=draft
# 0 disables automatic resume. Positive seconds moves WAITING conversations back to BOT.
PAGE_CSKH_WAITING_RESET_SECONDS=0
# 0 disables message debounce. Positive seconds waits for a quiet period before the bot replies.
PAGE_CSKH_MESSAGE_DEBOUNCE_SECONDS=2
# false keeps test conversations in BOT when the agent asks for human handoff.
PAGE_CSKH_ENABLE_HUMAN_HANDOFF=true
# JSON array of Telegram chat ids. Used for both ready-order notifications and
# handoff alerts (sent when a conversation moves to WAITING for a human).
PAGE_CSKH_ORDER_TELEGRAM_CHAT_IDS=[]

# Admin-only Facebook marketing post workflow. Disabled by default; approval is
# required before any Page publish.
PAGE_CSKH_ENABLE_MARKETING_POSTS=false
PAGE_CSKH_MARKETING_APPROVAL_REQUIRED=true
PAGE_CSKH_MARKETING_MAX_POSTS_PER_DAY=3
PAGE_CSKH_MARKETING_DEFAULT_TONE=thân thiện, chuyên nghiệp, ngắn gọn
PAGE_CSKH_MARKETING_TIMEZONE=Asia/Ho_Chi_Minh
PAGE_CSKH_MARKETING_QUIET_HOURS=22:00-07:00
# 0 = tắt ngưỡng (chỉ hiển thị điểm). 1-10 = dưới ngưỡng thì viết lại rồi xử lý theo LOW_SCORE_ACTION.
PAGE_CSKH_MARKETING_MIN_SCORE=0
# Số lần viết lại tối đa khi bài dưới ngưỡng (0-3). Chỉ dùng khi MIN_SCORE > 0.
PAGE_CSKH_MARKETING_REVISE_ATTEMPTS=1
# warn = vẫn gửi Telegram kèm cảnh báo; hold = không gửi, chỉ nằm trong admin UI.
PAGE_CSKH_MARKETING_LOW_SCORE_ACTION=warn

# Agent behavior text/scope.
PAGE_CSKH_SCOPE_DESCRIPTION=Chỉ tư vấn dịch vụ, sản phẩm và chính sách của Page này.
PAGE_CSKH_SCOPE_KEYWORDS=đặt hàng,giá,sản phẩm,chính sách
PAGE_CSKH_HANDOFF_TEXT=Em chuyển nhân viên hỗ trợ tiếp nhé.
PAGE_CSKH_OUT_OF_SCOPE_TEXT=Em chỉ hỗ trợ thông tin dịch vụ và sản phẩm của Page này ạ.
PAGE_CSKH_CLARIFY_TEXT=Anh/chị muốn tìm hiểu sản phẩm hoặc dịch vụ nào của bên em ạ?
PAGE_CSKH_MAX_DAILY_AGENT_CALLS=200
PAGE_CSKH_MAX_CUSTOMER_CALLS_PER_HOUR=20
PAGE_CSKH_AGENT_TIMEOUT_MS=45000
